<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SmartManagerLicenseGenerator</AssemblyName>
    <RootNamespace>SmartManager.LicenseGenerator</RootNamespace>
    <ApplicationTitle>SmartManager License Generator</ApplicationTitle>
    <!-- Lets the project restore/compile on non-Windows build machines (CI). The app itself runs on Windows x64 only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Self-contained single-file executable: dotnet publish -c Release -r win-x64 (see scripts/build-license-generator.sh) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\SmartManager.Licensing\SmartManager.Licensing.csproj" /></ItemGroup>
</Project>
